# Environment: local | ci | production
ENVIRONMENT=local
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=false

# Corpus source
CORPUS_REPO_URL=https://github.com/kubernetes/website.git
CORPUS_REPO_REF=main
CORPUS_DOCS_SUBPATH=content/en/docs
CORPUS_MIN_DOCUMENT_CHARS=200

# Anthropic API key for evaluation set generation
ANTHROPIC_API_KEY=
# Inference provider: anthropic | ollama | openai | bedrock | vllm
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=4096

OPENAI_API_KEY=

LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_VLLM_BASE_URL=http://localhost:8000/v1
LLM_VLLM_MODEL=data/models/awq
LLM_BEDROCK_REGION=us-east-1

# Qdrant
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=k8s_chunks
QDRANT_DENSE_VECTOR_SIZE=1024

# Embedding: set EMBED_DEVICE=cuda and EMBED_USE_FP16=true on a GPU
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DEVICE=cpu
EMBED_USE_FP16=false
EMBED_BATCH_SIZE=8
EMBED_MAX_LENGTH=1024

# Reranker
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_CANDIDATE_POOL=50

# Retrieval
RETRIEVAL_DENSE_CANDIDATES=50
RETRIEVAL_SPARSE_CANDIDATES=50
RETRIEVAL_RRF_K=60
RETRIEVAL_FINAL_TOP_K=10
RETRIEVAL_USE_RERANKER=true

# Agent
AGENT_MAX_REWRITES=2
AGENT_RELEVANCE_THRESHOLD=0.5
AGENT_MIN_RELEVANT_CHUNKS=1
AGENT_FAITHFULNESS_THRESHOLD=0.6
AGENT_MAX_CONTEXT_CHUNKS=6
AGENT_ENABLE_VERIFICATION=true

# Security
SECURITY_DEFAULT_TENANT=public
SECURITY_AUDIT_LOG_ENABLED=true
