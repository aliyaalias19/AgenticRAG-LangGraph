# Environment: local | ci | production
ENVIRONMENT=local
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=false

# Corpus source
CORPUS_REPO_URL=https://github.com/kubernetes/website.git
CORPUS_REPO_REF=main
CORPUS_DOCS_SUBPATH=content/en/docs
CORPUS_MIN_DOCUMENT_CHARS=200

# Anthropic API key for evaluation set generation
ANTHROPIC_API_KEY=
